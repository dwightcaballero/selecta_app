rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin role check: checks user token email or admin status in users collection
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) && 
         request.auth.token.email in ['admin@selecta.ph', 'superadmin@selecta.ph', 'dwightseu@gmail.com']) ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['admin', 'Admin', 'superadmin', 'Superadmin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'superadmin', 'Superadmin'])
      );
    }

    // Dealer or Admin check
    // Emergency migration bridge: allow any authenticated user so staff and dealers are not blocked
    function isDealerOrAdmin() {
      return isAuthenticated();
    }

    // Store user role check
    function isStoreUser() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Hapi Store') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Hapi Store')
      );
    }

    // Store ID helper
    function myStoreId() {
      return request.auth.token.keys().hasAll(['storeId']) ? request.auth.token.storeId :
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['storeId']) ?
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId : '');
    }

    // Staff check: Authenticated users
    function isStaff() {
      return isAuthenticated();
    }

    // Ledger Movement Validation Helper
    function validMovement(d) {
      return d.keys().hasAll(['productId', 'reason', 'previousStock', 'newStock', 'delta', 'createdBy', 'createdAt', 'movementType']) &&
        d.productId is string && d.productId.size() > 0 &&
        d.reason is string &&
        d.previousStock is int &&
        d.newStock is int &&
        d.delta is int &&
        d.newStock >= 0 &&
        d.delta == (d.newStock - d.previousStock) &&
        (
          (!d.keys().hasAny(['actorUid']) || d.actorUid == request.auth.uid || d.actorUid == '' || d.actorUid == null) ||
          (d.createdBy == request.auth.uid)
        ) &&
        (d.createdAt == request.time || d.keys().hasAny(['clientCreatedAt']));
    }

    // App Version info (open read for update check on splash/login, write admin only)
    match /app_version/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System configurations
    match /configurations/{configId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // Product custom sorting per dealer
    match /product_sort/{dealerId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // User management
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation on signup; prevent setting role to superadmin or store without permissions
      allow create: if isAuthenticated() && (
        (request.resource.data.role != 'superadmin' && request.resource.data.role != 'Hapi Store') || isDealerOrAdmin()
      );
      // Allow user to update their own profile, but prevent modifying role, storeId, or admin flags
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) && 
          request.resource.data.role == resource.data.role &&
          (!request.resource.data.keys().hasAny(['storeId']) || request.resource.data.storeId == resource.data.storeId)
        )
      );
      allow delete: if isAdmin();
    }

    // Product Catalogs (Selecta & Other Products)
    // Non-dealer/admin updates cannot bypass the ledger to directly alter stock fields
    match /selecta_products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isDealerOrAdmin();
      allow update: if isStaff() && (
        isDealerOrAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQuantity', 'reservedQuantity', 'incomingQuantity'])
      );
      allow delete: if isAdmin();
    }

    match /admin_selecta_products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    match /other_products/{productId} {
      allow read: if isStaff();
      allow create: if isDealerOrAdmin();
      allow update: if isStaff() && (
        isDealerOrAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQuantity', 'reservedQuantity', 'incomingQuantity'])
      );
      allow delete: if isDealerOrAdmin();
    }

    match /supplier_product_mappings/{mappingId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /booking_receipt_mappings/{mappingId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Stores (HapiStores) & Dealers
    match /hapistores/{storeId} {
      allow read: if isDealerOrAdmin() || isStaff() || (isStoreUser() && storeId == myStoreId());
      allow write: if isStaff();
    }

    match /dealers/{dealerId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // Store Self-Ordering: store_orders
    match /store_orders/{orderId} {
      allow read: if isDealerOrAdmin() || isStaff() || (isStoreUser() && resource.data.storeId == myStoreId());
      allow create: if isDealerOrAdmin() || (
        isStoreUser() &&
        request.resource.data.storeId == myStoreId() &&
        request.resource.data.status == 'Submitted' &&
        request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isDealerOrAdmin() || (
        isStoreUser() &&
        resource.data.storeId == myStoreId() &&
        resource.data.status == 'Submitted' &&
        request.resource.data.status == 'Cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusHistory'])
      );
      allow delete: if isAdmin();
    }

    // Store Usernames collection (uniqueness tracking)
    match /store_usernames/{username} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // Store login attempt tracking: server-side only via Admin SDK / Cloud Functions (Phase 1.1)
    match /store_login_attempts/{username} {
      allow read, write: if false;
    }

    // Catalog version metadata tracking (Phase 2.1)
    match /catalog_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // Store catalog summary docs (availability only, no stock quantities)
    match /store_catalog/{productId} {
      allow read: if isAuthenticated();
      allow write: if isDealerOrAdmin();
    }

    // Deliveries & Purchase Orders (Staff only)
    match /delivery/{deliveryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /purchaseorders/{poId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Proof of Visit (Photos & Field Notes - Staff only)
    match /proof_of_visit/{visitId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.storeName is string &&
        request.resource.data.storeName.size() > 0 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() > 0;
      allow update: if isStaff();
      allow delete: if isDealerOrAdmin();
    }

    // Proof of Return (Gated End of Day - Staff only)
    match /return_proofs/{proofId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.photoUrl is string &&
        request.resource.data.photoUrl.size() > 0 &&
        request.resource.data.storeId is string &&
        request.resource.data.storeId.size() > 0;
      allow update: if isDealerOrAdmin() || (
        isStaff() && resource.data.status in ['submitted', 'rejected'] && request.resource.data.status == 'submitted'
      );
      allow delete: if isDealerOrAdmin();
    }

    // PJP Order Decisions
    match /pjp_order_decisions/{decisionId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Tasks & Scanning
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /scanning/{scanId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Operational Logs & Transactions
    match /placement/{placementId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /badorder/{badOrderId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /breakdown/{breakdownId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /transactionlogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Inventory Movement Audit Ledger (Append-only: immutable historical records)
    match /inventory_movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strict audit immutability: movements cannot be modified or deleted
    }

    // Pending Inventory Adjustments for Threshold Approval
    match /inventory_pending_adjustments/{adjustmentId} {
      allow read: if isStaff();
      allow create: if isDealerOrAdmin() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isDealerOrAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedByName', 'reviewedAt', 'rejectionReason']);
      allow delete: if false;
    }

    // Inventory Discrepancies and Audit Runs
    match /inventory_discrepancies/{discrepancyId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasAll(['productId', 'productName', 'discrepancyType', 'message', 'status']);
      allow update: if isDealerOrAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionNotes', 'resolvedAt', 'resolvedBy', 'notes', 'resolution']);
      allow delete: if false;
    }

    match /inventory_audit_runs/{runId} {
      allow read: if isStaff();
      allow create: if isDealerOrAdmin();
      allow update, delete: if false;
    }

    // Daily Stock Snapshots (End of Day Reconciliation)
    match /inventory_snapshots/{snapshotId} {
      allow read: if isStaff();
      allow create: if isDealerOrAdmin();
      allow update, delete: if false;

      match /items/{productId} {
        allow read: if isStaff();
        allow create: if isDealerOrAdmin();
        allow update, delete: if false;
      }
    }

    // In-App Inventory Anomaly Alerts
    match /inventory_alerts/{alertId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isDealerOrAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgedBy', 'acknowledgedAt', 'acknowledgmentNote']);
      allow delete: if false;
    }

    // FCM Notification Device Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // Gemini AI Usage Quota Tracking
    match /gemini_api_usage/{monthKey} {
      allow read, write: if isAuthenticated();
    }

    // Error Logs (Diagnostic reporting)
    match /error_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Fallback rule: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
