  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.21.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "private": true
}
