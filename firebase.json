{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "selectaapp",
          "appId": "1:731338785867:android:81cc63e865752ca73b79ce",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "selectaapp",
          "configurations": {
            "android": "1:731338785867:android:81cc63e865752ca73b79ce",
            "web": "1:731338785867:web:9d0db626b42135cc3b79ce"
          }
        }
      }
    }
  }
}